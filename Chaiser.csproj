<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Chaiser</AssemblyName>
    <RootNamespace>Chaiser</RootNamespace>
    <!-- map builds allocate heavily on every core -->
    <ServerGarbageCollector>true</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Hash.xxHash" Version="1.0.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MessagePack" Version="3.1.4" />
    <PackageReference Include="Kyaru.Texture2DDecoder" Version="0.17.1" />
    <PackageReference Include="Kyaru.Texture2DDecoder.Windows" Version="0.2.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oodle for Star Rail blocks (x64 native; AnimeStudio's Ooz build, vendored) -->
    <None Include="native\AnimeStudio.Ooz.dll" Link="AnimeStudio.Ooz.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
